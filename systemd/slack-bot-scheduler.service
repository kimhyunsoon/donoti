# 상주 스케줄러 데몬 유저 서비스
# 설치: cp systemd/slack-bot-scheduler.service ~/.config/systemd/user/
#       systemctl --user daemon-reload && systemctl --user enable --now slack-bot-scheduler
[Unit]
Description=cansoon-slack-bot scheduler daemon
After=network-online.target

[Service]
WorkingDirectory=%h/workspace/etc/cansoon-slack-bot
ExecStart=%h/workspace/etc/cansoon-slack-bot/node_modules/.bin/tsx scheduler/index.ts
Restart=on-failure
RestartSec=10
# tsx 는 SIGTERM 종료 시 143 으로 나가므로 정상 종료로 취급
SuccessExitStatus=143

[Install]
WantedBy=default.target
